{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "outDir": ".tsbuild",
    "baseUrl": "."
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".tsbuild"]
}
